{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "crons": [
    {
      "path": "/api/crypto-floor/tick",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/crypto-floor/review",
      "schedule": "0 13 * * *"
    }
  ]
}
