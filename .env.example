# Shared Contraxis / Apixis Supabase project (schema awad_command).
NEXT_PUBLIC_SUPABASE_URL=https://myfclypikkcvfurkbzmj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Magic-link gate. Demo deck stays open until URL + anon key + this email are all set.
ALLOWED_EMAIL=

# CEO — Anthropic when AI_PROVIDER=anthropic (case-insensitive) AND ANTHROPIC_API_KEY is non-empty.
# Empty / whitespace key keeps the demo responder. API failures return provider:"error", not demo.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Phase 1 lead messaging. Delivery is claimed only after a real 2xx from the webhook.
# Hub contract: POST LEAD_MESSAGE_WEBHOOK_URL
#   body: { "agentId": "<uuid from orb map>", "message": "<text>", "projectSlug": "<optional>" }
#   header (picked): Authorization: Bearer <LEAD_MESSAGE_WEBHOOK_SECRET>
# If LEAD_MESSAGE_WEBHOOK_URL is unset, messages queue locally as DEMO — never "delivered".
# GROK_BOT_API_KEY is an optional alias for LEAD_MESSAGE_WEBHOOK_SECRET.
#
# Inbound (Lead reply → deck thread). Hub still owns this reverse hop.
#   POST /api/lead-inbound
#   Authorization: Bearer <LEAD_INBOUND_WEBHOOK_SECRET | LEAD_MESSAGE_WEBHOOK_SECRET>
#   body: { "agentId": "<uuid>", "message": "<text>", "projectSlug": "<optional>", "leadName": "<optional>" }
# Missing/wrong Bearer is 401. Deck polls GET /api/lead-thread?projectSlug=<slug>.
# CEO message_lead uses the same outbound helper as POST /api/lead-message.
LEAD_MESSAGE_WEBHOOK_URL=
LEAD_MESSAGE_WEBHOOK_SECRET=
LEAD_INBOUND_WEBHOOK_SECRET=
GROK_BOT_API_KEY=

# Optional news (server-only). Demo headlines are used when unset.
NEWS_API_KEY=

# Part C worker (Railway / local process — never expose these to the browser).
# Same SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY as above.
# WORKER_MODEL=claude-sonnet-5
# WORKER_ID=awad-worker-1
# See worker/README.md for the full Railway env list.
