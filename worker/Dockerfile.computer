FROM node:20-bookworm
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends xvfb \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.33.3 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
RUN pnpm add playwright@1.55.0 && npx playwright install --with-deps chromium

COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN pnpm build

ENV NODE_ENV=production
ENV WORKER_CAPABILITIES=computer
ENV WORKER_DATA_DIR=/data
ENV DISPLAY=:99

VOLUME ["/data"]

# Xvfb gives Chromium a display. noVNC / a live stream is not in this slice.
CMD ["sh", "-c", "Xvfb :99 -screen 0 1280x720x24 -ac +extension GLX +render -noreset & exec node dist/index.js"]
